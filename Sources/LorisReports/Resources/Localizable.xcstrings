        }
      }
    },
    "How serious is it?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est grave ?"
          }
        }
      }
    },
    "I've got everything I need. Tap Generate Report below — I'll attach only the relevant bits.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai tout ce qu'il me faut. Appuie sur Générer le rapport ci-dessous — je n'attache que les infos pertinentes."
